<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>	<string>English</string>
	<key>CFBundleDisplayName</key>		<string>PowerBar</string>
	<key>CFBundleIdentifier</key>		<string>io.github.cmstuberg.widget.PowerBar</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key>			<string>PowerBar</string>
	<key>CFBundleShortVersionString</key>	<string>1.0</string>
	<key>CFBundleVersion</key>		<string>1</string>
	<key>MainHTML</key>			<string>PowerBar.html</string>
	<key>Width</key>			<integer>330</integer>
	<key>Height</key>			<integer>124</integer>
	<key>CloseBoxInsetX</key>		<integer>14</integer>
	<key>CloseBoxInsetY</key>		<integer>11</integer>
