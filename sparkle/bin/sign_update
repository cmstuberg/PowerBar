#!/bin/sh
# sign_update: sign an update archive for your appcast.
#
#   sign_update ARCHIVE PRIVATE_KEY.pem
#
# Prints the two attributes your appcast's <enclosure> needs, for example
#   sparkle:edSignature="Vn0r...Ag==" length="15728640"
# Sign the exact file you upload, after any re-zipping. The signature is Ed25519
# over the whole archive, the same as Sparkle 2's sign_update. Before printing, the
# signature is checked against the key's public half.
#
# Needs OpenSSL 3 or later (set OPENSSL=/path/to/openssl if it isn't found).
set -e

find_openssl() {
  here=$(cd "$(dirname "$0")" && pwd)
  for o in "${OPENSSL:-}" "$here/../../tls/dist/bin/openssl" /opt/local/bin/openssl \
           /opt/homebrew/opt/openssl@3/bin/openssl /usr/local/opt/openssl@3/bin/openssl \
           /usr/local/bin/openssl /usr/bin/openssl; do
    [ -n "$o" ] && [ -x "$o" ] || continue
    case "$("$o" version 2>/dev/null)" in "OpenSSL "[3-9]*) echo "$o"; return 0 ;; esac
  done
  echo "sign_update: needs OpenSSL 3 or later; set OPENSSL=/path/to/openssl" >&2
  return 1
}

[ $# -eq 2 ] || { echo "usage: sign_update ARCHIVE PRIVATE_KEY.pem" >&2; exit 2; }
ARCHIVE=$1
KEY=$2
[ -f "$ARCHIVE" ] && [ -s "$ARCHIVE" ] || { echo "sign_update: $ARCHIVE: no such file, or empty" >&2; exit 1; }
OPENSSL=$(find_openssl) || exit 1
"$OPENSSL" pkey -in "$KEY" -noout -text 2>/dev/null | head -1 | grep -q "ED25519 Private-Key" \
  || { echo "sign_update: $KEY is not an Ed25519 private key (make one with generate_keys)" >&2; exit 1; }

TMP=${TMPDIR:-/tmp}/sign_update.$$
mkdir -m 700 "$TMP"
trap 'rm -rf "$TMP"' EXIT INT TERM
"$OPENSSL" pkeyutl -sign -rawin -inkey "$KEY" -in "$ARCHIVE" -out "$TMP/sig"
"$OPENSSL" pkey -in "$KEY" -pubout -out "$TMP/pub.pem"
"$OPENSSL" pkeyutl -verify -rawin -pubin -inkey "$TMP/pub.pem" -in "$ARCHIVE" -sigfile "$TMP/sig" >/dev/null \
  || { echo "sign_update: the new signature didn't verify; not printing it" >&2; exit 1; }
SIG=$("$OPENSSL" base64 -A < "$TMP/sig")
LEN=$(wc -c < "$ARCHIVE" | tr -d ' ')
echo "sparkle:edSignature=\"$SIG\" length=\"$LEN\""
